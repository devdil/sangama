{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "sangama"
  ],
  "model": "sangama/qwen2.5-0.5b-instruct",
  "small_model": "sangama/qwen2.5-0.5b-instruct",
  "default_agent": "sangama",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "*": "deny"
  },
  "compaction": {
    "auto": false
  },
  "provider": {
    "sangama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Sangama peers",
      "options": {
        "baseURL": "http://127.0.0.1:8090/v1",
        "apiKey": "{env:SANGAMA_API_KEY}"
      },
      "models": {
        "qwen2.5-0.5b-instruct": {
          "name": "Qwen 0.5B \u00b7 Sangama distributed test",
          "tool_call": false,
          "temperature": true,
          "limit": {
            "context": 4096,
            "output": 512
          }
        }
      }
    }
  },
  "agent": {
    "sangama": {
      "description": "Text-only coding suggestions from Sangama's small test model",
      "mode": "primary",
      "prompt": "You are a helpful coding assistant. When asked for code or a script, write it in full in your reply; the user will copy and run it. Also explain code and suggest fixes. Keep answers focused.",
      "temperature": 0,
      "steps": 3,
      "permission": {
        "*": "deny"
      }
    },
    "title": {
      "disable": true
    },
    "summary": {
      "disable": true
    }
  }
}
